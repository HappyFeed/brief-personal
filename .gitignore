# Dependencias / build (para cuando arranque el harness de Node)
node_modules/
dist/
.env

# Skills instaladas via skills-lock.json: se reinstalan desde ahi, no se versionan.
# Si agregas otra skill vendorizada, sumala aca.
.agents/skills/skill-creator/

# Config local de sesion, no es parte del proyecto
.claude/*

# Excepcion: los subagentes de proyecto si se versionan (recomendado
# por la doc de Claude Code para .claude/agents/).
!.claude/agents
